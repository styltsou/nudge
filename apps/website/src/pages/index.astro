---
import SiteLayout from '../layouts/SiteLayout.astro';
import Walkthrough from '../components/Walkthrough.astro';
import InstallCommands from '../components/InstallCommands.astro';
import Compatibility from '../components/Compatibility.astro';
---

<SiteLayout
  title="Nudge — visual context for your coding agent"
  description="Select an element in your running app, attach a request, and let your coding agent fetch the context through MCP. Review the change before accepting."
>
  <div class="page-frame shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          Show your coding agent
          <br />
          what you mean.
        </h1>
        <p class="hero-description">
          Select an element in your running app and tell your coding agent what
          to change. Run it from the browser, then review the result in place.
        </p>
        <InstallCommands />
        <div class="hero-actions">
          <a href="/docs/getting-started/" class="button-primary">
            Get started
          </a>
          <a href="/docs/agents/" class="button-secondary">
            Connect your agent
          </a>
        </div>
      </div>
    </section>
    <Compatibility />
    <section class="hero-demo" aria-label="Explore Nudge">
      <Walkthrough />
    </section>

    <ol class="workflow-rail" aria-label="How Nudge works">
      <li>
        <span class="rail-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 3l14 7-6 2-2 6z" />
          </svg>
        </span>
        <strong>Point at it</strong>
        <span>
          Select an element in your running app and describe the change.
        </span>
      </li>
      <li>
        <span class="rail-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6h16v12H4z" />
            <path d="m8 10 2 2-2 2M13 14h3" />
          </svg>
        </span>
        <strong>Your agent makes it</strong>
        <span>
          Codex, Claude or OpenCode runs in your project, started from the
          browser.
        </span>
      </li>
      <li>
        <span class="rail-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        <strong>Review it in place</strong>
        <span>
          Check the result on the page, then accept or ask for another pass.
        </span>
      </li>
    </ol>

    <section class="review-section" aria-labelledby="review-heading">
      <div class="review-copy">
        <h2 id="review-heading">
          Your request,
          <br />
          right next to the result.
        </h2>
        <p>
          When your agent finishes, return to the element you pointed at. Read
          what changed, check it in your app, and decide what happens next.
        </p>
        <div class="review-decision">
          <span class="review-decision-mark" aria-hidden="true">
            ✓
          </span>
          <p>
            <strong>Accept it, or ask for another pass.</strong>
            Your request and revision history stay together. Optional snapshots
            give you another way to compare.
          </p>
        </div>
        <a href="/docs/workflow/" class="button-text">
          How review works
        </a>
      </div>
      <figure class="real-review-image">
        <div class="evidence-header">
          <span>Review in context</span>
          <a href="/images/review.png">View full capture</a>
        </div>
        <a
          href="/images/review.png"
          class="review-crop"
          aria-label="Open the full Nudge review screenshot"
        >
          <img
            src="/images/review.png"
            width="1280"
            height="1242"
            loading="lazy"
            decoding="async"
            alt="Actual Nudge demo with a chart, before/after evidence, and human Accept and Request changes controls."
          />
        </a>
        <figcaption>Detail from a browser capture with test data.</figcaption>
      </figure>
    </section>

    <section class="local-section" aria-labelledby="local-heading">
      <h2 id="local-heading">
        Your project.
        <br /> Your tools.
      </h2>
      <div>
        <p>
          Requests, history and optional snapshots stay in your project's local{' '}
          <code>.nudge/</code> folder. Start Codex, Claude or OpenCode from
          Nudge, using your agent's own settings and approvals. Your agent may
          send context to its model provider.
        </p>
        <div class="inline-links">
          <a href="/docs/privacy/">Privacy and security</a>
          <a href="/docs/agents/">Connect your agent</a>
        </div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="faq-intro">
        <h2 id="faq-heading">
          A few things
          <br />
          you might ask.
        </h2>
        <p>
          Everything else is in the <a href="/docs/">Docs</a>.
        </p>
      </div>
      <div class="faq-list">
        <details>
          <summary>
            Which projects does Nudge work with?<span aria-hidden="true"></span>
          </summary>
          <p>
            Nudge supports standalone local Vite apps, including React, Vue and
            Svelte projects, and Astro. Next.js support is coming soon. Bun is
            required to run Nudge, even if your project uses another package
            manager. <a href="/docs/getting-started/">See the requirements</a>.
          </p>
        </details>
        <details>
          <summary>
            Which coding agents can I use?<span aria-hidden="true"></span>
          </summary>
          <p>
            Choose Codex, Claude or OpenCode and start a session from Nudge.
            Your agent keeps its own authentication, settings and approvals.
            These integrations are in preview; live authenticated runs still
            need validation. <a href="/docs/agents/">Learn about agent setup</a>
            .
          </p>
        </details>
        <details>
          <summary>
            Does my data leave my computer?<span aria-hidden="true"></span>
          </summary>
          <p>
            Nudge stores requests, history and optional snapshots in your
            project's <code>.nudge/</code> folder. Your agent may send request
            and project context to its model provider.{' '}
            <a href="/docs/privacy/">Read the privacy guide</a>.
          </p>
        </details>
        <details>
          <summary>
            How do I get started?<span aria-hidden="true"></span>
          </summary>
          <p>
            Install Nudge in your app, configure your agent, and start your dev
            server through Nudge. The package is currently an unpublished
            preview installed from a local archive.{' '}
            <a href="/docs/getting-started/">Follow the setup guide</a>.
          </p>
        </details>
      </div>
    </section>
  </div>
</SiteLayout>
