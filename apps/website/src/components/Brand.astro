---
interface Props {
  href?: string;
  class?: string;
}
const { href = '/', class: className = '' } = Astro.props;
---

<a href={href} class:list={['brand', className]} aria-label="Nudge home">
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M9 4H4v5m11-5h5v5M4 15v5h5m6 0h5v-5"
      stroke="currentColor"
      stroke-width="1.5"
    />
    <path
      d="M8.5 16V8.5m0 1.5H13l2.5 2.5V16"
      stroke="currentColor"
      stroke-width="2"
    />
  </svg>
  <span>Nudge</span>
</a>
