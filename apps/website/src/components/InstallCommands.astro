---
const managers = [
  { name: 'Bun', command: 'bun add -d usenudge@preview' },
  { name: 'npm', command: 'npm install -D usenudge@preview' },
  { name: 'pnpm', command: 'pnpm add -D usenudge@preview' },
];
---

<div class="install-box" data-install-box>
  <div class="install-header">
    <div role="tablist" aria-label="Choose your package manager">
      {managers.map((manager, index) => (
        <button
          type="button"
          role="tab"
          id={`install-tab-${index}`}
          aria-controls={`install-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {manager.name}
        </button>
      ))}
    </div>
  </div>
  {managers.map((manager, index) => (
    <div
      class="install-command"
      role="tabpanel"
      id={`install-panel-${index}`}
      aria-labelledby={`install-tab-${index}`}
      hidden={index !== 0}
    >
      <span class="prompt" aria-hidden="true">
        $
      </span>
      <code>{manager.command}</code>
      <button
        type="button"
        class="install-copy"
        aria-label={`Copy ${manager.name} install command`}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="8" y="8" width="12" height="12" rx="2" />
          <path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" />
        </svg>
        <svg
          class="copied-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </button>
    </div>
  ))}
  <span
    class="sr-only"
    role="status"
    aria-live="polite"
    data-copy-status
  ></span>
</div>

<script>
  import { showCopied } from '../scripts/copy-feedback';
  document
    .querySelectorAll<HTMLElement>('[data-install-box]')
    .forEach((box) => {
      const tabs = Array.from(
        box.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );
      const panels = Array.from(
        box.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
      );
      const status = box.querySelector<HTMLElement>('[data-copy-status]')!;
      function select(index: number, focus = false) {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          panels[i]!.hidden = i !== index;
        });
        status.textContent = '';
        if (focus) tabs[index]!.focus();
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index));
        tab.addEventListener('keydown', (event) => {
          const next =
            event.key === 'ArrowRight'
              ? (index + 1) % tabs.length
              : event.key === 'ArrowLeft'
                ? (index + tabs.length - 1) % tabs.length
                : event.key === 'Home'
                  ? 0
                  : event.key === 'End'
                    ? tabs.length - 1
                    : undefined;
          if (next === undefined) return;
          event.preventDefault();
          select(next, true);
        });
      });
      panels.forEach((panel) => {
        panel.querySelector('button')!.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(
              panel.querySelector('code')!.textContent ?? '',
            );
            status.textContent = 'Command copied.';
            showCopied(panel.querySelector('button')!, () => {
              status.textContent = '';
            });
          } catch {
            status.textContent =
              'Copy unavailable. Select the command to copy it manually.';
          }
        });
      });
    });
</script>

<style>
  .install-box {
    width: min(100%, 480px);
    margin: 32px auto 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    text-align: left;
    background: var(--surface);
  }
  .install-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  [role='tablist'] {
    display: flex;
  }
  [role='tab'] {
    border: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: var(--muted);
    padding: 12px 16px;
    font-size: 12px;
  }
  [role='tab'][aria-selected='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
    background: var(--canvas);
  }
  [role='tab']:hover,
  .install-copy:hover {
    background: linear-gradient(
      180deg,
      var(--btn-hover-top),
      var(--btn-hover-bottom)
    );
  }
  .install-command {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px;
  }
  .prompt {
    color: var(--muted);
    font: 13px var(--font-mono);
  }
  code {
    font-size: 13px;
    overflow-x: auto;
    white-space: nowrap;
  }
  /* Tactile icon button, matching the terminal's Copy; a check while copied. */
  .install-copy {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    margin-left: auto;
    padding: 0;
    color: var(--ink);
    border: 1px solid var(--btn-border);
    border-radius: 8px;
    background: linear-gradient(180deg, var(--btn-top), var(--btn-bottom));
    box-shadow:
      inset 0 1px 0 var(--hl),
      0 1px 2px var(--drop);
  }
  /* Icons crossfade with a blur so copy → check reads as one change. */
  .install-copy {
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background 120ms ease;
  }
  .install-copy > svg {
    grid-area: 1 / 1;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      filter 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .install-copy .copied-icon {
    color: var(--success);
  }
  .install-copy .copied-icon,
  .install-copy[data-copied] > svg:not(.copied-icon) {
    opacity: 0;
    transform: scale(0.6);
    filter: blur(4px);
  }
  .install-copy[data-copied] .copied-icon {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .install-copy:active {
    transform: scale(0.97);
    box-shadow: inset 0 1px 3px var(--well);
  }
  @media (prefers-reduced-motion: reduce) {
    .install-copy > svg {
      transform: none !important;
      filter: none !important;
    }
    .install-copy:active {
      transform: none;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    [role='tab'] {
      padding: 12px;
    }
    code {
      font-size: 11px;
    }
    .install-command {
      gap: 8px;
      padding-inline: 12px;
    }
  }
</style>
