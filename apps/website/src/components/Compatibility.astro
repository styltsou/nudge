---
import ClaudeWordmark from './ClaudeWordmark.astro';
---

<section class="compatibility" aria-labelledby="compatibility-heading">
  <h2 id="compatibility-heading">Works with your coding agent</h2>
  <ul class="agent-logos" aria-label="Coding agents">
    <li>
      <a href="/docs/agents/" aria-label="Set up Codex" class="codex-lockup">
        <span class="openai-mark" aria-hidden="true">
          <img
            class="light-mark"
            src="/images/brands/openai-light.svg"
            width="48"
            height="48"
            alt=""
          />
          <img
            class="dark-mark"
            src="/images/brands/openai-dark.svg"
            width="48"
            height="48"
            alt=""
          />
        </span>
        <span>Codex</span>
      </a>
    </li>
    <li>
      <a href="/docs/agents/" aria-label="Set up Claude">
        <span class="claude-wordmark" aria-hidden="true">
          <ClaudeWordmark />
        </span>
      </a>
    </li>
    <li>
      <a
        href="/docs/agents/"
        aria-label="Set up OpenCode"
        class="opencode-wordmark"
      >
        <img
          class="light-mark"
          src="/images/brands/opencode-light.svg"
          width="117"
          height="21"
          alt="OpenCode"
        />
        <img
          class="dark-mark"
          src="/images/brands/opencode-dark.svg"
          width="117"
          height="21"
          alt="OpenCode"
        />
      </a>
    </li>
  </ul>
</section>

<style>
  .compatibility {
    max-width: 848px;
    margin: 0 auto 56px;
    padding: 40px 24px 0;
    text-align: center;
  }
  h2 {
    color: var(--muted);
    font-size: 13px;
    font-weight: 450;
  }
  h2 {
    margin: 0 0 8px;
  }
  .agent-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px 48px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .agent-logos a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    color: var(--ink);
  }
  .agent-logos .codex-lockup {
    gap: 5px;
    font-size: 24px;
    font-weight: 550;
    letter-spacing: -0.04em;
  }
  .openai-mark {
    position: relative;
    width: 24px;
    height: 24px;
    flex: none;
  }
  /* The official export contains clear space around its 24px painted mark.
     Keep the source intact while sizing the layout box to the visible artwork. */
  .openai-mark img {
    position: absolute;
    inset: -12px;
    width: 48px;
    height: 48px;
    max-width: none;
  }
  img {
    display: block;
    object-fit: contain;
    flex: none;
  }
  .dark-mark {
    display: none;
  }
  :global([data-theme='dark']) .light-mark {
    display: none;
  }
  :global([data-theme='dark']) .dark-mark {
    display: block;
  }
  .claude-wordmark :global(svg) {
    display: block;
    width: 110px;
    height: 24px;
  }
  @media (hover: hover) and (pointer: fine) {
    .agent-logos a:hover {
      opacity: 0.75;
    }
  }
  @media (max-width: 680px) {
    .compatibility {
      padding: 40px 12px 0;
      margin-bottom: 40px;
    }
    .agent-logos {
      gap: 12px 24px;
    }
  }
</style>
