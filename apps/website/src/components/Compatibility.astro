---
import ClaudeWordmark from './ClaudeWordmark.astro';
---

<section class="compatibility" aria-labelledby="compatibility-heading">
  <h2 id="compatibility-heading">Works with your coding agent</h2>
  <ul class="agent-logos" aria-label="Coding agents">
    <li>
      <a href="/docs/agents/" aria-label="Set up Codex" class="codex-lockup">
        <span class="openai-mark" aria-hidden="true">
          <img
            class="light-mark"
            src="/images/brands/openai-light.svg"
            width="48"
            height="48"
            alt=""
          />
          <img
            class="dark-mark"
            src="/images/brands/openai-dark.svg"
            width="48"
            height="48"
            alt=""
          />
        </span>
        <span>Codex</span>
      </a>
    </li>
    <li>
      <a href="/docs/agents/" aria-label="Set up Claude">
        <span class="claude-wordmark" aria-hidden="true">
          <ClaudeWordmark />
        </span>
      </a>
    </li>
    <li>
      <a
        href="/docs/agents/"
        aria-label="Set up OpenCode"
        class="opencode-wordmark"
      >
        <img
          class="light-mark"
          src="/images/brands/opencode-light.svg"
          width="156"
          height="28"
          alt="OpenCode"
        />
        <img
          class="dark-mark"
          src="/images/brands/opencode-dark.svg"
          width="156"
          height="28"
          alt="OpenCode"
        />
      </a>
    </li>
  </ul>

  <div class="frameworks" aria-labelledby="frameworks-heading">
    <h3 id="frameworks-heading">Built for your stack</h3>
    <ul class="framework-grid" aria-label="Framework support">
      <li>
        <a class="framework-tile" href="/docs/getting-started/">
          <span class="framework-icon">
            <img src="/images/brands/vite.svg" width="36" height="36" alt="" />
          </span>
          <strong>Vite</strong>
          <span class="framework-detail">Your Vite-powered app</span>
        </a>
      </li>
      <li>
        <a class="framework-tile" href="/docs/getting-started/">
          <span class="framework-icon react-vite" aria-hidden="true">
            <img src="/images/brands/react.svg" width="28" height="28" alt="" />
            <span>+</span>
            <img src="/images/brands/vite.svg" width="24" height="24" alt="" />
          </span>
          <strong>React + Vite</strong>
          <span class="framework-detail">Same app, visual feedback</span>
        </a>
      </li>
      <li>
        <a class="framework-tile" href="/docs/getting-started/">
          <span class="framework-icon" aria-hidden="true">
            <img
              class="light-mark"
              src="/images/brands/astro-light.svg"
              width="29"
              height="36"
              alt=""
            />
            <img
              class="dark-mark"
              src="/images/brands/astro-dark.svg"
              width="29"
              height="36"
              alt=""
            />
          </span>
          <strong>Astro</strong>
          <span class="framework-detail">Right in your local project</span>
        </a>
      </li>
      <li class="framework-tile framework-upcoming">
        <span class="framework-icon">
          <img
            class="nextjs-mark"
            src="/images/brands/nextjs.ico"
            width="32"
            height="32"
            alt=""
          />
        </span>
        <strong>Next.js</strong>
        <span class="coming-soon">Coming soon</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .compatibility {
    max-width: 848px;
    margin: 0 auto 56px;
    padding-inline: 24px;
    text-align: center;
  }
  h2,
  h3 {
    color: var(--muted);
    font-size: 13px;
    font-weight: 450;
  }
  h2 {
    margin: 0 0 24px;
  }
  .agent-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px 48px;
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
  }
  .agent-logos a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    color: var(--ink);
  }
  .codex-lockup {
    gap: 2px;
    font-size: 24px;
    font-weight: 550;
    letter-spacing: -0.04em;
  }
  img {
    display: block;
    object-fit: contain;
    flex: none;
  }
  .dark-mark {
    display: none;
  }
  :global([data-theme='dark']) .light-mark {
    display: none;
  }
  :global([data-theme='dark']) .dark-mark {
    display: block;
  }
  .claude-wordmark :global(svg) {
    display: block;
    width: 110px;
    height: 24px;
  }
  .agent-logos a:hover {
    opacity: 0.75;
  }
  .frameworks {
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  h3 {
    margin: 0 0 20px;
  }
  .framework-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .framework-grid > li {
    min-width: 0;
  }
  .framework-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 100%;
    min-height: 148px;
    padding: 20px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface), var(--canvas));
    box-shadow: inset 0 1px 0 var(--hl);
  }
  a.framework-tile:is(:hover, :focus-visible) {
    border-color: var(--line-strong);
    background: var(--surface);
  }
  .framework-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    margin-bottom: 4px;
  }
  .react-vite {
    gap: 5px;
    color: var(--muted);
    font-size: 12px;
  }
  strong {
    color: var(--ink);
    font-size: 14px;
    font-weight: 550;
  }
  .framework-detail {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .framework-upcoming {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }
  .nextjs-mark {
    border-radius: 50%;
  }
  .coming-soon {
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 5px;
  }
  @media (max-width: 680px) {
    .compatibility {
      padding-inline: 12px;
      margin-bottom: 32px;
    }
    .agent-logos {
      gap: 12px 32px;
    }
    .framework-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .framework-tile {
      min-height: 140px;
      padding-inline: 8px;
    }
  }
</style>
