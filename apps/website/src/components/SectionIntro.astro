---
interface Props {
  headingId: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}
const { headingId, title, description, href, linkLabel } = Astro.props;
---

<div class="section-intro">
  <div class="section-copy">
    <h2 id={headingId}>{title}</h2>
    <p>{description}</p>
  </div>
  {href && linkLabel && (
    <a class="section-guide" href={href}>
      {linkLabel}
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M7 7h10v10" />
      </svg>
    </a>
  )}
</div>

<style>
  .section-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .section-copy {
    min-width: 0;
  }
  h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 430;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }
  p {
    max-width: 640px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
  }
  .section-guide {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    color: var(--muted);
    font-size: 13px;
  }
  .section-guide:is(:hover, :focus-visible) {
    color: var(--accent);
  }
  @media (max-width: 680px) {
    .section-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }
    p {
      font-size: 14px;
    }
  }
</style>
