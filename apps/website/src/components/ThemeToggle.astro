<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Switch color theme"
>
  <svg
    class="theme-sun"
    width="19"
    height="19"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
  </svg>
  <svg
    class="theme-moon"
    width="19"
    height="19"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: var(--theme-toggle-width, 72px);
    border: 0;
    border-inline-start: 1px solid var(--line, var(--sl-color-hairline));
    padding: 0;
    color: var(--muted, var(--sl-color-gray-3));
    background: transparent;
    cursor: pointer;
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--nudge-accent);
    outline-offset: -5px;
  }
  .theme-toggle svg {
    width: 20px;
    height: 20px;
  }
  .theme-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-sun {
    display: block;
  }
  :global([data-theme='dark']) .theme-moon {
    display: none;
  }
  @media (max-width: 520px) {
    .theme-toggle {
      width: var(--theme-toggle-width, 44px);
    }
  }
</style>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'),
  );
  const systemTheme = matchMedia('(prefers-color-scheme: dark)');
  type Theme = 'light' | 'dark';
  const parsePreference = (value: string | null): Theme | null =>
    value === 'light' || value === 'dark' ? value : null;
  let preference: Theme | null = null;
  try {
    preference = parsePreference(localStorage.getItem('starlight-theme'));
  } catch {
    /* Use the system initially. */
  }
  function updateLabels() {
    for (const button of buttons)
      button.setAttribute(
        'aria-label',
        document.documentElement.dataset.theme === 'dark'
          ? 'Switch to light theme'
          : 'Switch to dark theme',
      );
  }
  function applyPreference() {
    document.documentElement.dataset.theme =
      preference ?? (systemTheme.matches ? 'dark' : 'light');
    updateLabels();
  }
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const theme =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      preference = theme;
      try {
        localStorage.setItem('starlight-theme', theme);
      } catch {
        /* The theme still works without storage. */
      }
      updateLabels();
    });
  }
  systemTheme.addEventListener('change', () => {
    if (preference === null) applyPreference();
  });
  window.addEventListener('storage', (event) => {
    if (event.key !== null && event.key !== 'starlight-theme') return;
    preference = parsePreference(event.newValue);
    applyPreference();
  });
  applyPreference();
</script>
