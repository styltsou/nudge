{
  "name": "@usenudge/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro dev --host localhost",
    "build": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro build --force",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro preview --host localhost",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "motion": "^14.14.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12"
  }
}
