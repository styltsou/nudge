{
  "name": "nudge-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run website:dev",
    "website:dev": "bun run --filter @usenudge/website dev",
    "website:build": "bun run --filter @usenudge/website build",
    "website:preview": "bun run --filter @usenudge/website preview",
    "website:check": "bun run --filter @usenudge/website typecheck",
    "website:test": "bun --bun playwright test --config playwright.website.config.ts",
    "build": "bun run typecheck && bun run --filter '@usenudge/*' build",
    "package:release": "bun scripts/package-release.ts",
    "package:check": "bun scripts/check-release.ts",
    "release:check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:e2e && bun run website:test && bun run package:release && bun run package:check",
    "typecheck": "bun --bun tsc --noEmit && bun run website:check",
    "lint": "bun --bun oxlint --deny-warnings packages apps scripts tests",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun test ./packages ./tests/contracts --timeout 10000",
    "test:e2e": "bun --bun playwright test",
    "bridge:doctor": "bun packages/cli/src/index.ts doctor",
    "bridge:setup": "bun packages/cli/src/index.ts setup",
    "state:clean": "bun packages/cli/src/index.ts clean",
    "mcp": "bun packages/mcp/src/index.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "jsdom": "30.1.3",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
